# Treeks 日记应用配置
PORT=3000
# 留空时首次启动会生成并持久化随机密钥；生产环境建议显式设置独立随机值
JWT_SECRET=
JWT_EXPIRES=7d
UPLOAD_DIR=public/uploads
MAX_UPLOAD_SIZE=10
MAX_PDF_SIZE=50
# CORS 白名单（逗号分隔）。默认仅允许同源请求；
# 若前后端分离部署，填允许跨域的来源，如 https://app.example.com
CORS_ORIGINS=
# Optional AI writing assistant (OpenAI-compatible Chat Completions API).
# 管理后台配置的多模型优先于这些环境变量；API Key 仅在服务端加密保存。
# 留空时使用内置本地写作辅助。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
